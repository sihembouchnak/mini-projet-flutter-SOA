<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:tns="http://tn.chatboot/soap"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             targetNamespace="http://tn.chatboot/soap"
             name="ChatService">
  <types><xsd:schema targetNamespace="http://tn.chatboot/soap"/></types>
  <message name="sendMessage"><part name="message" type="xsd:string"/></message>
  <message name="sendMessageResponse"><part name="return" type="xsd:string"/></message>
  <message name="getConversationSummary"><part name="conversationId" type="xsd:string"/></message>
  <message name="getConversationSummaryResponse"><part name="return" type="xsd:string"/></message>
  <portType name="ChatServicePortType">
    <operation name="sendMessage">
      <input message="tns:sendMessage"/><output message="tns:sendMessageResponse"/>
    </operation>
    <operation name="getConversationSummary">
      <input message="tns:getConversationSummary"/><output message="tns:getConversationSummaryResponse"/>
    </operation>
  </portType>
  <binding name="ChatServiceBinding" type="tns:ChatServicePortType">
    <soap:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="sendMessage"><soap:operation soapAction="sendMessage"/><input><soap:body use="literal"/></input><output><soap:body use="literal"/></output></operation>
    <operation name="getConversationSummary"><soap:operation soapAction="getConversationSummary"/><input><soap:body use="literal"/></input><output><soap:body use="literal"/></output></operation>
  </binding>
  <service name="ChatService">
    <port name="ChatServicePort" binding="tns:ChatServiceBinding">
      <soap:address location="http://localhost:8181/chat"/>
    </port>
  </service>
</definitions>
